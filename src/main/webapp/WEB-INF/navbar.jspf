<%-- =====================================================
     NAVBAR PRO - SMARTWEB AI
     Fragment reutilisable : <%@ include file="/WEB-INF/navbar.jspf" %>
===================================================== --%>
<header class="snav" id="snav">
    <div class="snav-inner">

        <!-- LOGO -->
        <a class="snav-brand" href="${pageContext.request.contextPath}/index.jsp"
           aria-label="SMARTWEB AI - Accueil">
            <span class="snav-logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/>
                    <path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16z"/>
                </svg>
            </span>
            <span class="snav-name">SMARTWEB <b>AI</b></span>
        </a>

        <!-- MENU -->
        <div class="snav-menu" id="snav-menu" role="navigation"
             aria-label="Navigation principale">

            <span class="snav-indicator" aria-hidden="true"></span>

            <a class="snav-link" data-page="index"
               href="${pageContext.request.contextPath}/dashboard.jsp">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 11.5L12 4l9 7.5"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>
                </svg>
                <span>Accueil</span>
            </a>

            <a class="snav-link" data-page="weather"
               href="${pageContext.request.contextPath}/weather.jsp">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 18a4 4 0 010-8 5.5 5.5 0 0110.6 1.5A3.3 3.3 0 0117 18H7z"/>
                </svg>
                <span>Meteo</span>
            </a>

            <a class="snav-link" data-page="chat"
               href="${pageContext.request.contextPath}/chat.jsp">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12a8 8 0 01-11.6 7.1L4 20l1-4.6A8 8 0 1121 12z"/>
                </svg>
                <span>Assistant IA</span>
            </a>
        </div>

        <!-- ACTIONS -->
        <div class="snav-actions">
            <a class="snav-cta" href="${pageContext.request.contextPath}/chat.jsp">
                <span>Essayer l'IA</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
                </svg>
            </a>

            <button class="snav-burger" type="button" aria-label="Ouvrir le menu"
                    aria-expanded="false" aria-controls="snav-menu">
                <span></span><span></span><span></span>
            </button>
        </div>

    </div>
</header>
